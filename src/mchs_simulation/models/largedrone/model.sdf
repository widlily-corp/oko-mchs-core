<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Large Rescue Drone (STL by Studio Mechanik).

    Ориентация меша:
      * исходный STL: нос (подвес камеры) смотрит в -Y;
      * поворот yaw = +90° переводит -Y в +X, как требует ROS/Gazebo;
      * масштаб 0.01: 100 единиц STL = 1 м, габариты ~1.0×0.8×0.35 м;
      * visual поднят на 0.17685 м, чтобы нижняя точка меша была на z=0.
  -->
  <model name="largedrone">
    <static>false</static>
    <pose>0 0 0.05 0 0 0</pose>

    <link name="base_link">
      <!-- Плагин planar_move управляет высотой через pose; гравитация
           выключена, иначе дрон медленно проседает с 22 м и геопривязка
           считает площадь по заниженной высоте. -->
      <gravity>false</gravity>
      <inertial>
        <mass>4.8</mass>
        <inertia>
          <ixx>0.306</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.450</iyy><iyz>0</iyz>
          <izz>0.656</izz>
        </inertia>
      </inertial>

      <!-- Простая коллизия по габаритам: 1M треугольников в физике не нужны. -->
      <collision name="body_collision">
        <pose>0 0 0.17685 0 0 0</pose>
        <geometry>
          <box><size>1.00 0.80 0.354</size></box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <pose>0 0 0.17685 0 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://largedrone/meshes/largedrone.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.85 0.32 0.05 1</ambient>
          <diffuse>1.00 0.42 0.06 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- Курсовая камера: нос +X, наклон вниз 45°, как в старой модели. -->
      <sensor type="camera" name="mchs_camera">
        <pose>0.42 0 0.12 0 0.785398 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <camera name="mchs_cam">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>300.0</far>
          </clip>
        </camera>
        <plugin name="mchs_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/mchs</namespace>
            <remapping>image_raw:=camera/image_raw</remapping>
            <remapping>camera_info:=camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_optical_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- Кинематическое движение по /mchs/cmd_vel и одометрия в /mchs/odom. -->
    <plugin name="mchs_flight_controller" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/mchs</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <robot_base_frame>base_link</robot_base_frame>
      <odometry_frame>odom</odometry_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </model>
</sdf>
